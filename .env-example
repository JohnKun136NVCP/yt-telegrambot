# Copy this file to .env and fill in the values (or just run
# ./scripts/setup.sh, which writes .env for you interactively).
#
# .env is loaded by main.py via python-dotenv and must never be committed --
# it holds your bot token. scripts/setup.sh writes it with chmod 600.

# =============================================================================
# Required
# =============================================================================

# Bot token from @BotFather on Telegram.
TOKEN=

# Comma-separated Telegram user ids with admin access (/grant, /revoke,
# /refund, /stats). Get your own id from @userinfobot. Leave empty for no
# admins (not recommended).
ADMIN_IDS=

# =============================================================================
# File size tiers
# =============================================================================
# Telegram's cloud Bot API refuses to upload/download files over 50 MB no
# matter what this bot sends. STANDARD_MAX_MB applies to everyone;
# PREMIUM_MAX_MB only has any effect once BOT_API_BASE_URL (below) points at
# a self-hosted local Bot API server -- otherwise premium/admin users are
# silently capped at STANDARD_MAX_MB too (see
# src/config.py: Config.effective_premium_max_mb()).

STANDARD_MAX_MB=49.5
PREMIUM_MAX_MB=1900

# =============================================================================
# Local Telegram Bot API server (optional)
# =============================================================================
# Only needed to go over the 50 MB cloud-API cap. Built and wired up
# automatically by scripts/setup.sh if you opt in; see
# https://github.com/tdlib/telegram-bot-api to build it by hand instead.
#
# Host[:port] of your local server, e.g. http://127.0.0.1:8081 -- no "/bot"
# suffix, no trailing slash. Leave empty to use Telegram's cloud API.
BOT_API_BASE_URL=
# true once BOT_API_BASE_URL is set and the bot runs on the SAME machine (and
# ideally the same system user) as the local server, so files can be handed
# over as file:// paths instead of being re-uploaded over HTTP.
BOT_API_LOCAL_MODE=false

# Credentials for the local server itself, from https://my.telegram.org/apps.
# NOT read by the bot (src/config.py never looks at these) -- scripts/setup.sh
# stores them here purely so a re-run doesn't ask for them again, and so it
# can fill them into the telegram-bot-api systemd unit's ExecStart line.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# =============================================================================
# Download queue
# =============================================================================
# Bounded, persistent (survives a restart/crash without losing track of what
# was in flight -- but never silently auto-resumes a job after an unclean
# shutdown, it only notifies the user their request was lost).

# Max requests allowed to sit in the wait queue before new ones are rejected
# with a "queue is full" message instead of piling up.
QUEUE_MAX_SIZE=50
# Concurrent downloads/conversions/uploads.
QUEUE_WORKERS=2
# Hard per-job timeout (seconds) so one stuck download/ffmpeg call can't
# occupy a worker forever.
JOB_TIMEOUT_SECONDS=1800

# =============================================================================
# Flood control
# =============================================================================
# Minimum seconds a single user must wait between requests.
MIN_SECONDS_BETWEEN_REQUESTS=3

# =============================================================================
# Telegram Stars subscription plans (payments)
# =============================================================================
# Format: code:label:days:stars,code:label:days:stars,...
# Leave empty to use the bundled defaults (1 week / 1 month / 1 year -- see
# src/config.py: DEFAULT_PLANS). 1 Telegram Star is roughly $0.013 USD, a
# rate Telegram sets, not this bot.
STAR_PLANS=
